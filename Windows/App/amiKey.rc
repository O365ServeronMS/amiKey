#include <windows.h>
#include "resource.h"
IDI_APP ICON "amiKey.ico"
IDI_TRAY_V_LIGHT ICON "Icons/tray-V-light.ico"
IDI_TRAY_V_DARK ICON "Icons/tray-V-dark.ico"
IDI_TRAY_E_LIGHT ICON "Icons/tray-E-light.ico"
IDI_TRAY_E_DARK ICON "Icons/tray-E-dark.ico"
1 24 "amiKey.manifest"
IDR_SOUND_VI RCDATA "Sounds/SwitchToVietnamese.wav"
IDR_SOUND_EN RCDATA "Sounds/SwitchToEnglish.wav"
IDR_EMOJI_JSON RCDATA "Resources/Emoji.json"
IDR_AMI_WORDMARK RCDATA "Resources/ami-wordmark.png"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION AMIKEY_VERSION_NUM
 PRODUCTVERSION AMIKEY_VERSION_NUM
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ami"
      VALUE "FileDescription", "amiKey - Vietnamese typing"
      VALUE "FileVersion", AMIKEY_VERSION
      VALUE "InternalName", "amiKey"
      VALUE "LegalCopyright", "GPL-3.0. Based on Vikey by Tony Dinh and OpenKey by Tuyen Mai."
      VALUE "OriginalFilename", "amiKey.exe"
      VALUE "ProductName", "amiKey"
      VALUE "ProductVersion", AMIKEY_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
